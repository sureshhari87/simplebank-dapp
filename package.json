{
  "name": "simplebank-hardhat",
  "version": "1.0.0",
  "description": "A production-ready Hardhat DeFi banking prototype with staking-style interest and withdrawal protections.",
  "main": "hardhat.config.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "compile": "hardhat compile && node scripts/generateFrontendConfig.js",
    "generate:config": "node scripts/generateFrontendConfig.js",
    "test": "hardhat test",
    "test:smoke": "hardhat test test/SuiteMonetizationSmoke.test.js",
    "coverage": "hardhat coverage",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "audit:tooling": "npm audit --audit-level=high",
    "security:slither": "slither . --filter-paths \"node_modules|artifacts|cache|coverage\" --exclude arbitrary-send-eth,reentrancy-balance,divide-before-multiply,incorrect-equality,calls-loop,reentrancy-events,timestamp,low-level-calls,missing-inheritance",
    "security:slither:full": "slither . --filter-paths \"node_modules|artifacts|cache|coverage\"",
    "monitor": "node monitor.js",
    "preflight:sepolia": "hardhat run scripts/preflight.js --network sepolia",
    "preflight:mainnet": "hardhat run scripts/preflight.js --network mainnet",
    "reserve:check:sepolia": "hardhat run scripts/checkInterestReserve.js --network sepolia",
    "reserve:check:mainnet": "hardhat run scripts/checkInterestReserve.js --network mainnet",
    "admin:sepolia": "hardhat run scripts/admin.js --network sepolia",
    "admin:mainnet": "hardhat run scripts/admin.js --network mainnet",
    "admin:encode:sepolia": "hardhat run scripts/encodeAdminAction.js --network sepolia",
    "admin:encode:mainnet": "hardhat run scripts/encodeAdminAction.js --network mainnet",
    "deploy:vault:sepolia": "hardhat run scripts/deployVault.js --network sepolia",
    "deploy:vault:mainnet": "hardhat run scripts/deployVault.js --network mainnet",
    "deploy:strategy-vault:sepolia": "hardhat run scripts/deployStrategyVault.js --network sepolia",
    "deploy:strategy-vault:mainnet": "hardhat run scripts/deployStrategyVault.js --network mainnet",
    "deploy:strategy-manager:sepolia": "hardhat run scripts/deployStrategyManager.js --network sepolia",
    "deploy:strategy-manager:mainnet": "hardhat run scripts/deployStrategyManager.js --network mainnet",
    "strategy-vault:encode:sepolia": "hardhat run scripts/encodeStrategyVaultAction.js --network sepolia",
    "strategy-vault:encode:mainnet": "hardhat run scripts/encodeStrategyVaultAction.js --network mainnet",
    "strategy-manager:sepolia": "hardhat run scripts/strategyManagerAction.js --network sepolia",
    "strategy-manager:mainnet": "hardhat run scripts/strategyManagerAction.js --network mainnet",
    "strategy-manager:encode:sepolia": "hardhat run scripts/encodeStrategyManagerAction.js --network sepolia",
    "strategy-manager:encode:mainnet": "hardhat run scripts/encodeStrategyManagerAction.js --network mainnet",
    "vault:auto-invest:sepolia": "hardhat run scripts/autoInvestVault.js --network sepolia",
    "vault:auto-invest:mainnet": "hardhat run scripts/autoInvestVault.js --network mainnet",
    "vault:treasury:encode:sepolia": "hardhat run scripts/encodeVaultTreasuryRedeem.js --network sepolia",
    "vault:treasury:encode:mainnet": "hardhat run scripts/encodeVaultTreasuryRedeem.js --network mainnet",
    "deploy:lending:sepolia": "hardhat run scripts/deployLendingPool.js --network sepolia",
    "deploy:lending:mainnet": "hardhat run scripts/deployLendingPool.js --network mainnet",
    "lending:sepolia": "hardhat run scripts/lendingPoolAction.js --network sepolia",
    "lending:mainnet": "hardhat run scripts/lendingPoolAction.js --network mainnet",
    "lending:encode:sepolia": "hardhat run scripts/encodeLendingPoolAction.js --network sepolia",
    "lending:encode:mainnet": "hardhat run scripts/encodeLendingPoolAction.js --network mainnet",
    "deploy:swap:sepolia": "hardhat run scripts/deploySwapPool.js --network sepolia",
    "deploy:swap:mainnet": "hardhat run scripts/deploySwapPool.js --network mainnet",
    "swap:sepolia": "hardhat run scripts/swapPoolAction.js --network sepolia",
    "swap:mainnet": "hardhat run scripts/swapPoolAction.js --network mainnet",
    "swap:encode:sepolia": "hardhat run scripts/encodeSwapPoolAction.js --network sepolia",
    "swap:encode:mainnet": "hardhat run scripts/encodeSwapPoolAction.js --network mainnet",
    "deploy:treasury:sepolia": "hardhat run scripts/deployTreasury.js --network sepolia",
    "deploy:treasury:mainnet": "hardhat run scripts/deployTreasury.js --network mainnet",
    "treasury:sepolia": "hardhat run scripts/treasuryAction.js --network sepolia",
    "treasury:mainnet": "hardhat run scripts/treasuryAction.js --network mainnet",
    "treasury:encode:sepolia": "hardhat run scripts/encodeTreasuryAction.js --network sepolia",
    "treasury:encode:mainnet": "hardhat run scripts/encodeTreasuryAction.js --network mainnet",
    "emergency:encode:sepolia": "hardhat run scripts/encodeEmergencyAction.js --network sepolia",
    "emergency:encode:mainnet": "hardhat run scripts/encodeEmergencyAction.js --network mainnet",
    "suite:health:sepolia": "hardhat run scripts/suiteHealth.js --network sepolia",
    "suite:health:mainnet": "hardhat run scripts/suiteHealth.js --network mainnet",
    "suite:revenue:sepolia": "hardhat run scripts/suiteRevenueReport.js --network sepolia",
    "suite:revenue:mainnet": "hardhat run scripts/suiteRevenueReport.js --network mainnet",
    "mainnet:readiness": "node scripts/mainnetReadiness.js",
    "production:check": "node scripts/productionReadiness.js",
    "verify:sepolia": "hardhat run scripts/verifyDeployments.js --network sepolia",
    "verify:mainnet": "hardhat run scripts/verifyDeployments.js --network mainnet",
    "vault:sepolia": "hardhat run scripts/vaultAction.js --network sepolia",
    "vault:mainnet": "hardhat run scripts/vaultAction.js --network mainnet",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.0",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.17"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.6",
    "dotenv": "^16.6.1"
  },
  "type": "commonjs"
}

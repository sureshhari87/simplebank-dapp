# Copy this file to .env and fill in your values.

# Deployment wallet (never share this private key)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Ethereum mainnet RPC endpoint (Alchemy/Infura/QuickNode/etc.)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Ethereum Sepolia RPC endpoint
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Contract and monitoring settings
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
MONITOR_WS_RPC_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
SEPOLIA_WS_RPC_URL=wss://sepolia.infura.io/ws/v3/YOUR_API_KEY
LARGE_WITHDRAWAL_THRESHOLD_ETH=10

# Initial contract settings
INITIAL_INTEREST_RATE=100
INITIAL_MAX_TOTAL_DEPOSITS_ETH=10
INITIAL_DEPOSIT_FEE_BPS=0
INITIAL_WITHDRAWAL_FEE_BPS=0
# Mainnet must use a deployed Safe/multisig contract with threshold >= 2
INITIAL_OWNER=0xYOUR_MULTISIG_OR_WALLET_ADDRESS
INITIAL_TREASURY=
BANK_TREASURY=

# ETH/WETH vault settings
WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
AAVE_POOL_ADDRESS=0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2
AAVE_AWETH_ADDRESS=0x4d5F47FA6A74757f35C14fD3a6Ef8E3C9BC514E8
VAULT_OWNER=0xYOUR_MULTISIG_OR_WALLET_ADDRESS
VAULT_TREASURY=
VAULT_PERFORMANCE_FEE_BPS=500
VAULT_MAX_TOTAL_ASSETS_ETH=2
STRATEGY_MAX_ASSETS_ETH=1

# Auto-invest keeper settings
IDLE_BUFFER_BPS=2000
MIN_INVEST_ETH=0.000001
MAX_INVEST_ETH=
EXECUTE=false

# Lending pool settings
LENDING_OWNER=0xYOUR_MULTISIG_OR_WALLET_ADDRESS
LENDING_TREASURY=
LENDING_BORROW_APR_BPS=800
LENDING_ORIGINATION_FEE_BPS=10
LENDING_MAX_POOL_LIQUIDITY_ETH=2
LENDING_MAX_LTV_BPS=6000
LENDING_LIQUIDATION_THRESHOLD_BPS=8000
LENDING_LIQUIDATION_BONUS_BPS=500

# DEX/swap pool settings
# Token0 can inherit WETH_ADDRESS if left empty.
SWAP_TOKEN0_ADDRESS=
SWAP_TOKEN1_ADDRESS=0xYOUR_SECOND_ERC20_ADDRESS
SWAP_OWNER=0xYOUR_MULTISIG_OR_WALLET_ADDRESS
SWAP_TREASURY=
SWAP_FEE_BPS=30
SWAP_PROTOCOL_FEE_SHARE_BPS=2000
# Sepolia-only helper for a local test pair when SWAP_TOKEN1_ADDRESS is unavailable.
DEPLOY_SWAP_TEST_TOKEN=false
SWAP_TEST_TOKEN_NAME=SimpleBank Swap Test Token
SWAP_TEST_TOKEN_SYMBOL=SBS
SWAP_TEST_TOKEN_DECIMALS=18
SWAP_TEST_TOKEN_MINT=1000000

# Treasury contract settings
TREASURY_OWNER=0xYOUR_MULTISIG_OR_WALLET_ADDRESS
TREASURY_ADDRESS=
TREASURY_OPERATOR=
TREASURY_OPERATOR_ALLOWED=true
ASSET_ADDRESS=ETH
ASSET_ENABLED=true
SPEND_LIMIT=0
RECIPIENT=
AMOUNT=
AMOUNT_ETH=
TOKEN_ADDRESS=
TOKEN_AMOUNT=
TREASURY_ASSETS=
EXPECTED_TREASURY=
TARGET=
CALL_VALUE_ETH=0
CALL_DATA=0x

# Public mainnet launch gates.
# These are checked by npm.cmd run production:check.
AUDIT_REPORT_PATH=docs/audits/latest-mainnet-audit.pdf
AUDIT_FINDINGS_RESOLVED=false
STATIC_ANALYSIS_REVIEWED=false
DEPENDENCY_AUDIT_REVIEWED=false
TOOLING_AUDIT_REVIEWED=false
LEGAL_REVIEW_DONE=false
MAINNET_SAFE_REVIEWED=false
MONITORING_CONFIGURED=false
INCIDENT_RESPONSE_REVIEWED=false
EMERGENCY_DRILL_COMPLETED=false
FRONTEND_PRODUCTION_REVIEWED=false

# Interest reserve policy:
# reserve needed ~= expected TVL * APY * period_days / 365
# EXPECTED_TVL_ETH defaults to the TVL cap during deploy preflight and to maxTotalDeposits during live checks.
EXPECTED_TVL_ETH=
INTEREST_RESERVE_PERIOD_DAYS=30

# Deployment safety switches
PREFLIGHT_ONLY=false
ALLOW_REDEPLOY=false

REPORT_GAS=true
